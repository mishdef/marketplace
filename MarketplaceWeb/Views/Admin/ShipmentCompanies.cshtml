@model IEnumerable<MarketplaceData.Model.ShipmentCompany>
@{
    ViewData["Title"] = "Shipment Companies";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Shipment Companies</h2>
        <a asp-action="CreateShipmentCompany" class="btn btn-primary">Add New</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var company in Model)
            {
                <tr>
                    <td>@company.Id</td>
                    <td>@company.Name</td>
                    <td>
                        <a asp-action="EditShipmentCompany" asp-route-id="@company.Id" class="btn btn-sm btn-outline-primary me-2">Edit</a>
                        <form asp-action="DeleteShipmentCompany" asp-route-id="@company.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this shipment company?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
