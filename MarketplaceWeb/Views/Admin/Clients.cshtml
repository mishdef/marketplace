@using MarketplaceData.Model.User
@model IEnumerable<User>
@{
    ViewData["Title"] = "Clients Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Clients</h2>
        <a asp-action="CreateClient" class="btn btn-primary">Create New Client</a>
    </div>

    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.Id</td>
                    <td>@client.FullName</td>
                    <td>@client.Email</td>
                    <td>@client.PhoneNumber</td>
                    <td>@(client.ClientInfo?.Address ?? "N/A")</td>
                    <td>
                        <a asp-action="EditClient" asp-route-id="@client.Id" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="DeleteClient" asp-route-id="@client.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this client?');">
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
