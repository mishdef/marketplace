@model VetClassLibrary.Model.Item
@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <div class="row">
        <div class="col-2">
        <button class="btn btn-secondary mb-3" onclick="history.back()">&larr; Back</button>
        
    </div>
    </div>
    <div class="row">
        <div class="col-5">
            <img class="shadow" style="width: 100%; height: auto;" src="@Model.ImageUrls.FirstOrDefault()" alt="Alternate Text" />
        </div>
        <div class="col-7">
            <h1>@Model.Name</h1>
            <p>@Model.Description</p>
            <p><strong>Price: </strong> $@Model.Price</p>
            
            <p class="mb-2"><strong>Availability: </strong> @ViewBag.AvailableQuantity in stock</p>
            
            <form asp-controller="Cart" asp-action="Add" method="post" class="mt-3">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="input-group mb-3" style="max-width: 200px;">
                    <input type="number" name="qty" class="form-control" value="1" min="1" max="@ViewBag.AvailableQuantity" @(ViewBag.AvailableQuantity <= 0 ? "disabled" : "") />
                    <button class="btn btn-primary" type="submit" @(ViewBag.AvailableQuantity <= 0 ? "disabled" : "")>Add to Cart</button>
                </div>
            </form>
        </div>
        <a class="card mt-4 p-3 shadow-sm" style="text-decoration: none;" href="@Url.Action("Company", "Home", new { id = Model.CompanyId })">
            <div class="card-body p-0">
                <div class="d-flex align-items-center">
                    <div class="me-3" style="flex-shrink: 0;">
                        <img class="rounded-circle border shadow-sm"
                             src="@Model.Company?.LogoUrl"
                             alt="Logo"
                             style="width: 60px !important; height: 60px !important; min-width: 60px; min-height: 60px; object-fit: cover; display: block;" />
                    </div>
                    <div>
                        <h3 class="h5 mb-1">@Model.Company?.Name</h3>
                        <p class="text-muted mb-0" style="font-size: 0.9rem;">@Model.Company?.Description</p>
                    </div>
                </div>
            </div>
        </a>

        @{
            var companyRecs = ViewBag.CompanyRecommendations as List<VetClassLibrary.Model.Item>;
            var similarItems = ViewBag.SimilarItems as List<VetClassLibrary.Model.Item>;
        }

        @if (companyRecs != null && companyRecs.Any())
        {
            <div class="mt-5">
                <h3 class="mb-3">More from @Model.Company?.Name</h3>
                <div class="row">
                    @foreach (var item in companyRecs)
                    {
                        <component type="typeof(MarketplaceWeb.Components.ItemCard)"
                                   render-mode="Static"
                                   param-Item="item" />
                    }
                </div>
            </div>
        }

        @if (similarItems != null && similarItems.Any())
        {
            <div class="mt-5">
                <h3 class="mb-3">Similar items from other sellers</h3>
                <div class="row">
                    @foreach (var item in similarItems)
                    {
                        <component type="typeof(MarketplaceWeb.Components.ItemCard)"
                                   render-mode="Static"
                                   param-Item="item" />
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Success Modal -->
@if (TempData["Success"] != null)
{
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center pb-4">
                    <div class="mb-3 text-success">
                        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-check-circle" viewBox="0 0 16 16">
                          <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                          <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                        </svg>
                    </div>
                    <h5 class="mb-3">@TempData["Success"]</h5>
                    <a href="@Url.Action("Index", "Cart")" class="btn btn-primary">Go to Cart</a>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Continue Shopping</button>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var myModal = new bootstrap.Modal(document.getElementById('successModal'));
            myModal.show();
        });
    </script>
}
