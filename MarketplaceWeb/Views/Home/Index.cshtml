@model List<VetClassLibrary.Model.Item>
@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card mb-4 shadow-sm">
                    <img src="@(item.ImageUrls?.Any() == true ? item.ImageUrls[0] : "https://via.placeholder.com/300x200?text=No+Image")" class="card-img-top" alt="@item.Name">
                    <div class="card-body">
                        <h5 class="card-title
                            ">
                            @item.Name
                        </h5>
                        <p class="card-text">
                            @item.Description
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group">
                                <a href="/Item/Details/@item.Id" class="btn btn-outline-primary">View details</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
