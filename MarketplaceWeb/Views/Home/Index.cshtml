@model List<VetClassLibrary.Model.Item>
@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <div class="row">
        <div class="col-3">
            <h1 class="my-4">Marketplace</h1>
        </div>
        <div class="col-9">
            <div class="container">
                <div class="row">
                    @foreach (var item in Model)
                    {
                        <component type="typeof(MarketplaceWeb.Components.ItemCard)"
                                   render-mode="Static"
                                   param-Item="item" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>
