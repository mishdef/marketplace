@using MarketplaceWeb.DTO
@model CategoryViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <div class="row">
        <div class="col-2">
            <button class="btn btn-secondary mb-3" onclick="history.back()">&larr; Back</button>
            </div>
        <div class="col-10">
            <h2 class="text-center">@Model.Category.Name</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-3">
            <h1 class="my-4">Categories</h1>
            <div class="list-group">
                @foreach (var category in Model.Categories)
                {
                    <a href="@Url.Action("Category", new { id = category.Id })"
                       class="list-group-item list-group-item-action">
                        @category.Name
                    </a>
                }
            </div>
        </div>
        <div class="col-9">
            <div class="container-fluid">
                <div class="row">
                    @foreach (var item in Model.Items)
                    {
                        <component type="typeof(MarketplaceWeb.Components.ItemCard)"
                                   render-mode="Static"
                                   param-Item="item" />
                    }
                </div>
            </div>
        </div>
    </div>
</div>
