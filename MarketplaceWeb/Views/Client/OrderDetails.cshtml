@using MarketplaceData.Model.Cart
@model Order

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Client" asp-action="Orders">My Orders</a></li>
            <li class="breadcrumb-item active" aria-current="page">Order #@Model.Id</li>
        </ol>
    </nav>

    <h2>Order #@Model.Id Details</h2>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <p><strong>Date:</strong> @Model.Date.ToString("g")</p>
                    <p><strong>Status:</strong> @Model.Status</p>
                    <p><strong>Total:</strong> @Model.Total.ToString("C")</p>
                    @if (Model.Company != null)
                    {
                        <p><strong>Seller:</strong> @Model.Company.Name</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Items in this Order</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Image</th>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderItems != null && Model.OrderItems.Any())
                                {
                                    foreach (var item in Model.OrderItems)
                                    {
                                        <tr>
                                            <td>
                                                @if (item.Product?.ImageUrls != null && item.Product.ImageUrls.Any())
                                                {
                                                    <img src="@item.Product.ImageUrls.FirstOrDefault()" alt="@item.Product.Name" style="max-height: 50px; max-width: 50px;" class="img-thumbnail" />
                                                }
                                                else
                                                {
                                                    <div class="bg-light text-center rounded border" style="width: 50px; height: 50px; line-height: 50px;">
                                                        <small class="text-muted">No Img</small>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (item.Product != null)
                                                {
                                                    <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Product.Id" class="text-decoration-none">
                                                        @item.Product.Name
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Product Removed</span>
                                                }
                                            </td>
                                            <td>@item.Product.Price.ToString("C")</td>
                                            <td>@item.Quantity</td>
                                            <td>@item.Subtotal.ToString("C")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-3">No items found for this order.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="text-end fw-bold">Total:</td>
                                    <td class="fw-bold">@Model.Total.ToString("C")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
