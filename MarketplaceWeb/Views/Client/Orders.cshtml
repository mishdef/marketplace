@using MarketplaceData.Model.Cart
@model List<Order>

<h1>My Orders</h1>
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Status</th>
                <th>Items</th>
                <th>Total</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var order in Model)
                {
                    <tr style="cursor: pointer;" onclick="window.location.href='@Url.Action("OrderDetails", "Client", new { id = order.Id })'">
                        <td class="fw-bold">#@order.Id</td>
                        <td>@order.Date.ToString("g")</td>
                        <td>
                            @{
                                var statusClass = order.Status.ToString() == "Pending" ? "bg-warning" : 
                                                  order.Status.ToString() == "Completed" ? "bg-success" : 
                                                  order.Status.ToString() == "Cancelled" ? "bg-danger" : "bg-secondary";
                            }
                            <span class="badge @statusClass">@order.Status</span>
                        </td>
                        <td>@(order.OrderItems?.Sum(i => i.Quantity) ?? 0)</td>
                        <td class="fw-bold">@order.Total.ToString("C")</td>
                        <td>
                            <a asp-controller="Client" asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary" onclick="event.stopPropagation();">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">You don't have any orders yet.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
