@using MarketplaceWeb.DTO
@model CheckoutViewModel

<div class="container">
    <div class="card mb-4 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Seller: @Model.CompanyCart.Company.Name</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CompanyCart.CartItems)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (item.Product?.ImageUrls?.Any() == true)
                                    {
                                        <img src="@item.Product.ImageUrls.First()" alt="Product" style="width: 50px; height: 50px; object-fit: cover; margin-right: 15px;" />
                                    }
                                    <a href="@Url.Action("Details", "Home", new { id = item.ProductId })">@item.Product?.Name</a>
                                </div>
                            </td>
                            <td class="align-middle">$@item.Product?.Price</td>
                            <td class="align-middle">
                                <form asp-controller="Cart" asp-action="UpdateQty" method="post" class="d-flex" style="max-width: 150px;">
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <input type="number" name="qty" class="form-control form-control-sm" value="@item.Quantity" min="1" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary ms-1">Update</button>
                                </form>
                            </td>
                            <td class="align-middle">$@item.Subtotal</td>
                            <td class="align-middle">
                                <form asp-controller="Cart" asp-action="Remove" method="post">
                                    <input type="hidden" name="cartItemId" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr>
                        <td colspan="3" class="text-end"><strong>Company Subtotal:</strong></td>
                        <td colspan="2"><strong>$@Model.CompanyCart.CartItems.Sum(ci => ci.Subtotal)</strong></td>
                    </tr>
                </tfoot>
            </table>

            <div class="container">

            </div>
        </div>
    </div>

    <div class="card mt-4 shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0">Shipping Details</h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" asp-controller="Payment" method="post">
                <input type="hidden" name="companyId" value="@Model.CompanyCart.CompanyId" />
                
                <div class="mb-3">
                    <label for="shipmentCompany" class="form-label">Shipment Company</label>
                    <select class="form-select" id="shipmentCompany" name="shipmentCompany" required>
                        <option value="">Choose a shipment company...</option>
                        @if (Model.ShipmentCompanies != null && Model.ShipmentCompanies.Any())
                        {
                            foreach(var company in Model.ShipmentCompanies)
                            {
                                <option value="@company.Name">@company.Name</option>
                            }
                        }
                        else
                        {
                            <option value="Standard Shipping">Standard Shipping</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="shipmentAddress" class="form-label">Shipment Address</label>
                    <input type="text" class="form-control" id="shipmentAddress" name="shipmentAddress" placeholder="e.g. 123 Main St, City, Country" required />
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary px-4">Proceed to Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>
