@model MarketplaceData.Model.Cart.Order

@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="mb-4">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
            </div>
            <h1 class="mb-3">Payment Successful!</h1>
            <p class="lead text-muted mb-4">Thank you for your purchase. Your payment has been successfully processed.</p>

            @if (Model != null)
            {
                <div class="card shadow-sm text-start mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-2"><strong>Order ID:</strong> #@Model.Id</p>
                        <p class="mb-2"><strong>Date:</strong> @Model.Date.ToString("g")</p>
                        <p class="mb-2"><strong>Status:</strong> <span class="badge bg-warning text-dark">@Model.Status</span></p>
                        @if (!string.IsNullOrEmpty(Model.ShipmentCompany))
                        {
                            <p class="mb-2"><strong>Shipment Company:</strong> @Model.ShipmentCompany</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.ShipmentAddress))
                        {
                            <p class="mb-2"><strong>Shipment Address:</strong> @Model.ShipmentAddress</p>
                        }
                        <hr />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Total Paid:</span>
                            <span class="fs-5 fw-bold text-success">@Model.Total.ToString("C")</span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-4 text-start">
                    Your order was already processed and saved in your account. 
                </div>
            }

            <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                @if (Model != null)
                {
                    <a asp-controller="Client" asp-action="OrderDetails" asp-route-id="@Model.Id" class="btn btn-outline-primary px-4 gap-3">View Order Details</a>
                }
                else
                {
                    <a asp-controller="Client" asp-action="Orders" class="btn btn-outline-primary px-4 gap-3">View My Orders</a>
                }
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">Continue Shopping</a>
            </div>
        </div>
    </div>
</div>
