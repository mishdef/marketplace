@using VetClassLibrary.Model

<div class="col-md-4" style="cursor: pointer;">
    <a class="card mb-4 shadow-sm" style="cursor: pointer; text-decoration: none;" href="/Home/Details/@Item.Id">
                    <img style="height: 200px; object-fit: contain;" src="@(Item.ImageUrls?.Any() == true ? Item.ImageUrls[0] : "https://via.placeholder.com/300x200?text=No+Image")" class="card-img-top" alt="@Item.Name">
        <div class="card-body text-decoration: none;">
                        <h5 class="card-title
                            ">
                            @Item.Name
                        </h5>
                        <p class="card-text">
                            @Item.Description
                        </p>
                        <p class="card-text text-end">
                            <strong>Price: </strong> $@Item.Price
                        </p>
                    </div>
                </a>
            </div>

@code {
    [Parameter]
    public Item Item { get; set; }
}